.workspace { flex-grow: 1; color: #e8f1f0; -unity-font-definition: url("project://database/Assets/EternalSteam/Shared/Fonts/NotoSansCJKkr-Regular.otf"); }
.inventory-panel { position: absolute; left: 8%; right: 8%; bottom: 20px; height: 270px; background-color: rgba(14,25,30,0.96); border-width: 1px; border-color: #50666d; }
.inventory-header { flex-direction: row; height: 44px; flex-shrink: 0; margin-top: -44px; }
.row { flex-direction: row; }
.grow { flex-grow: 1; }
.tab { width: 84px; height: 44px; margin: 0; border-bottom-width: 0; border-radius: 0; font-size: 16px; }
.action { width: 84px; height: 44px; margin: 0; border-bottom-width: 0; border-radius: 0; font-size: 16px; }
.primary { background-color: #386a5d; }
.inventory-scroll { flex-grow: 1; padding: 12px; }
.inventory-items { flex-direction: row; flex-wrap: wrap; }
.inventory-cell { width: 12.49%; min-width: 0; flex-shrink: 0; padding: 4px; }
.inventory-item { width: 100%; min-width: 0; height: 72px; margin: 0; white-space: normal; font-size: 13px; }
.empty { color: #92a9ad; -unity-text-align: middle-center; height: 95px; }
.inventory-footer { padding-left: 12px; padding-right: 12px; padding-bottom: 6px; flex-shrink: 0; }
.test-panel { position: absolute; top: 18px; bottom: 350px; right: 18px; width: 250px; padding: 14px; background-color: rgba(14,25,30,0.92); border-width: 1px; border-color: #45646a; }
.title { font-size: 20px; -unity-font-style: bold; margin-bottom: 8px; }
.note { white-space: normal; font-size: 12px; color: #bbcdcf; margin-top: 4px; margin-bottom: 4px; }
.mode { color: #80dfc1; margin-bottom: 4px; }
.message { color: #ffdc9f; white-space: normal; font-size: 12px; }
Button { background-color: #29424a; color: #edf6f3; border-width: 1px; border-color: #4f7175; border-radius: 3px; height: 30px; margin-top: 3px; margin-bottom: 3px; }
Button:hover { background-color: #3a6267; }
Button.selected { background-color: #356a5d; border-color: #93e7c8; }
Button:disabled { opacity: 0.38; }
TextField { margin-top: 4px; margin-bottom: 6px; }
.unity-text-field__input { background-color: #172c33; color: #ffffff; padding: 8px; border-width: 1px; border-color: #718d93; }
.unity-scroller { width: 10px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.unity-base-slider__tracker { background-color: #172c33; }
.unity-base-slider__dragger { background-color: #58777c; border-radius: 4px; }

.clock-panel { position: absolute; left: 18px; top: 18px; width: 230px; padding: 12px; background-color: rgba(14,25,30,0.92); border-width: 1px; border-color: #45646a; }

.day-night-dial { width: 140px; height: 140px; align-self: center; }
.dial-day { position: absolute; top: 25px; left: 59px; color: rgb(56,43,20); }
.dial-night { position: absolute; bottom: 25px; left: 59px; color: white; }

.resource-panel { position: absolute; left: 270px; right: 286px; top: 18px; padding: 10px; background-color: rgba(14,25,30,0.94); border-width: 1px; border-color: #45646a; }
.resource-title { font-size: 12px; color: #bbcdcf; margin-bottom: 4px; }
.resource-stock { font-size: 14px; color: #edf6f3; white-space: normal; }

.inventory-panel.folded { height: 0; border-width: 0; }
.test-panel.folded { bottom: auto; }
.test-body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
