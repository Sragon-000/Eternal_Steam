<ui:UXML xmlns:ui="UnityEngine.UIElements">
 <ui:Style src="OpenWorldHud.uss" />
 <ui:VisualElement class="workspace" picking-mode="Ignore">
  <ui:ScrollView name="panel" class="panel">
   <ui:Label text="테스트 그라운드" class="title" />
   <ui:Label text="ETERNAL STEAM / OPEN WORLD" class="subtitle" />
   <ui:Label name="mode" class="mode" />
   <ui:Label name="counts" class="note" />
   <ui:Label text="01  토대와 포탑" class="section" />
   <ui:Button name="foundation" text="토대 설치 · 8×8m" />
   <ui:VisualElement name="towers" />
   <ui:Button name="edit" text="수정 · 포탑 회수" />
   <ui:Button name="explore" text="편집 종료" />
   <ui:Label text="토대 설치 → 포탑 종류 선택 → 토대 칸 클릭 → 공격 방향 클릭&#10;수정 모드에서 포탑 칸을 클릭하면 회수" class="note" />
   <ui:Label text="02  적 소환" class="section" />
   <ui:TextField name="amount" value="100" max-length="4" />
   <ui:Button name="spawn" text="입력한 수량 소환" />
   <ui:Label text="1~4,000마리 · 화면 중심의 왼쪽에서 생성&#10;오른쪽으로 이동하며 토대는 통과합니다." class="note" />
   <ui:Button name="run" text="전투 실행" />
   <ui:Button name="reset" text="적 초기화" />
   <ui:Label text="WASD  카메라 이동 / 휠  확대·축소&#10;우클릭·Esc  설치 취소 / 편집 시 전투 정지" class="note" />
   <ui:Label name="message" class="message" />
  </ui:ScrollView>
 </ui:VisualElement>
</ui:UXML>
