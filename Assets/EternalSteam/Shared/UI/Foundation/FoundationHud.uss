.workspace {
    flex-grow: 1;
    color: #e8f1f0;
    -unity-font-definition: url("project://database/Assets/EternalSteam/Shared/Fonts/NotoSansCJKkr-Regular.otf");
}
.sidebar {
    width: 320px;
    max-height: 100%;
    padding: 18px;
    background-color: rgba(12, 25, 31, 0.96);
    border-right-width: 1px;
    border-right-color: #386365;
}
.title { font-size: 23px; -unity-font-style: bold; margin-bottom: 6px; }
.subtitle { font-size: 12px; color: #83cfc9; margin-bottom: 18px; }
.section { font-size: 14px; -unity-font-style: bold; margin-top: 12px; margin-bottom: 6px; }
.note { white-space: normal; font-size: 12px; color: #b6c9ce; margin-bottom: 10px; }
.message { white-space: normal; color: #ffd697; margin-top: 12px; }
Button {
    background-color: #203d46;
    color: #e8f1f0;
    border-width: 1px;
    border-color: #3c6570;
    border-radius: 4px;
    padding: 9px 10px;
    margin: 3px 0;
    white-space: normal;
}
Button:hover { background-color: #315e65; }
Button:disabled { color: #839399; background-color: #253239; }
.primary { background-color: #216e65; border-color: #59bbae; }
.selected { border-color: #f1d995; border-width: 2px; }
.row { flex-direction: row; }
.row > Button { flex-grow: 1; margin-right: 4px; }
.hidden { display: none; }

.catalog { max-height: 240px; flex-shrink: 0; }
