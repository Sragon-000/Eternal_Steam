<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="HordeHud.uss" />
  <ui:VisualElement class="root" picking-mode="Ignore">
    <ui:VisualElement name="hud" class="hud">
      <ui:Label text="ETERNAL STEAM / HORDE PROTOTYPE" class="title" />
      <ui:Label name="stats" class="stats" text="Starting simulation..." />
      <ui:VisualElement class="controls">
        <ui:Button name="low" text="50/s" class="button" />
        <ui:Button name="medium" text="100/s" class="button" />
        <ui:Button name="high" text="300/s" class="button" />
        <ui:Button name="pause" text="Pause spawns" class="button" />
        <ui:Button name="reset" text="Reset enemies" class="button" />
        <ui:Button name="clear" text="Clear turrets" class="button" />
      </ui:VisualElement>
      <ui:Label name="hint" class="hint" text="Click on the blue banks to place a turret" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
